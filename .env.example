# Copy to .env. Generate a random shared secret, for example: openssl rand -hex 32
AUTH_SECRET=
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
RCON_TIMEOUT=10
MCP_PORT=8000
# Use /gtnh_identity in your group to discover actual platform/group/user values.
ALLOWED_GROUPS='["aiocqhttp:123456789"]'
ADMIN_USERS='["aiocqhttp:987654321"]'
GTNH_CONTAINER_NAME=gtnh
GTNH_SERVER_ROOT=/volume1/docker/gtnh
GTNH_BACKUP_DIR=/volume1/docker/gtnh/backup
STOP_TIMEOUT=180
STARTUP_TIMEOUT=900
MAX_ARCHIVE_BYTES=107374182400
MAX_ARCHIVE_MEMBERS=1000000
FREE_SPACE_RESERVE=1073741824
