# MCP/恢复服务配置。复制为 .env；Compose env_file 将运行变量传入服务。
# QQ 名单仅属于插件，请在 AstrBot 插件页面或其原部署环境配置。

# 固定 Bearer 访问密钥，至少 32 字符；插件和 Inspector 使用完全相同的值。
# 建议 openssl rand -hex 32；不是 RCON 密码。含 #、$、空格时使用单引号。
AUTH_SECRET=

# MCP 监听 IP。127.0.0.1 仅限 NAS 本机/同主机 host 网络；远程可用 SSH 隧道。
# 需要直接局域网访问时可设置 NAS IP 或 0.0.0.0，并限制防火墙访问范围。
MCP_HOST=127.0.0.1
# Streamable HTTP 监听端口，修改后同步插件/Inspector 的 /mcp URL。
MCP_PORT=8000

# MCP/恢复服务访问 GTNH RCON 的地址。GTNH bridge 网络需先发布宿主机端口。
RCON_HOST=127.0.0.1
RCON_PORT=25575
# 必须与 GTNH server.properties 的 rcon.password 一致。
RCON_PASSWORD=
# RCON 单次连接/响应超时秒数，1–120；写操作不会自动重试。
RCON_TIMEOUT=10

# 只允许操作的 GTNH 实际容器名，由 Compose 映射为 CONTAINER_NAME。
GTNH_CONTAINER_NAME=gtnh
# NAS 宿主机 GTNH 根目录；必须预先存在并包含世界与 backups，勿填写项目代码目录。
GTNH_SERVER_ROOT=/volume2/sharev9/minecraft/gtnh
# 必填：在 NAS 执行 stat -c '%g' /var/run/docker.sock 得到的组 GID。
# Compose group_add 使用此数字；不要猜测默认 docker 组编号。
DOCKER_GID=

# 恢复容器内的 GTNH 根目录，Compose 将宿主机根目录挂载到这里。
# 这是存档路径，镜像进程 WORKDIR 仍为 /app。
SERVER_ROOT=/gtnh
# 容器内备份路径，无需第二条挂载；通常为 SERVER_ROOT 下的 backups。
BACKUP_DIR=/gtnh/backups
# 世界目录名，大小写必须与线上和归档内一致；旧部署可填 Worlds。
WORLD_DIRECTORY=World
# 两服务共享的容器内 socket、操作锁和维护标记目录。
RUNTIME_DIR=/run/gtnh
# 恢复服务任务日志的容器内持久目录；不要丢弃该命名卷。
STATE_DIR=/state

# RCON stop 后等待容器退出的最长秒数；超时不会强杀。
STOP_TIMEOUT=180
# 启动容器后等待 RCON 就绪的最长秒数。
STARTUP_TIMEOUT=900
# 归档或撤销来源的文件总展开大小上限，字节；默认 100 GiB。
MAX_ARCHIVE_BYTES=107374182400
# 归档或撤销来源的文件/目录条目数上限。
MAX_ARCHIVE_MEMBERS=1000000
# 暂存后需剩余的磁盘空间，字节；默认 1 GiB，旧存档不会自动删除。
FREE_SPACE_RESERVE=1073741824
