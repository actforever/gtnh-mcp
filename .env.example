# GTNH MCP 配置模板。复制为 .env 后填写真实值；.env 已被 Git 忽略。

# AstrBot 插件签发身份、MCP 与恢复服务验签所用的共享随机密钥。
# 必填，至少 32 字符。建议执行 `openssl rand -hex 32`；它不是 RCON 密码。
AUTH_SECRET=

# MCP/恢复服务从 NAS 宿主机访问 GTNH RCON 的地址和端口。
# 三个服务都使用 host 网络时保留 127.0.0.1；GTNH 使用 bridge 网络时，
# 应先把 RCON 端口绑定到 NAS 的 127.0.0.1，再填写该宿主机端口。
RCON_HOST=127.0.0.1
RCON_PORT=25575

# 必须与 GTNH server.properties 的 rcon.password 一致。
# 含 #、$、空格等字符时用单引号包住整个值，例如：'p@ss#word$2026'。
RCON_PASSWORD=

# 单次 RCON 建连和读取的超时秒数，范围 1–120。写命令超时后不会自动重试。
RCON_TIMEOUT=10

# FastMCP Streamable HTTP 监听端口；修改后同步修改 AstrBot 插件的 mcp_url。
MCP_PORT=8000

# 允许使用工具的群，JSON 数组，元素格式为“平台名:群ID”。
# QQ 官方机器人以 /gtnh_identity 实际输出为准，群 ID 不应直接填普通 QQ 群号。
ALLOWED_GROUPS='["qq_official:REPLACE_WITH_GROUP_ID"]'

# 可管理白名单和恢复备份的用户，JSON 数组，格式为“平台名:用户ID”。
# 不会自动继承 QQ 群管理员；空数组表示无人有管理权限。
# 使用 /gtnh_identity 返回的用户 ID，不要直接填普通 QQ 号。
ADMIN_USERS='["qq_official:REPLACE_WITH_USER_ID"]'

# 现有 GTNH Docker 容器的实际名称，通过 `docker ps --format '{{.Names}}'` 查询。
GTNH_CONTAINER_NAME=gtnh

# NAS 上直接包含 World 和 visualprospecting 的游戏服务端根目录。
GTNH_SERVER_ROOT=/volume2/sharev9/minecraft/gtnh

# NAS 上存放 *.zip 或 *.tar.gz 的现有备份目录，实际为游戏根目录下的 backups。
GTNH_BACKUP_DIR=/volume2/sharev9/minecraft/gtnh/backups

# 世界目录名，必须与线上目录和备份顶层一致；默认 World，旧部署可填写 Worlds。
WORLD_DIRECTORY=World

# 发出 RCON stop 后等待 Docker 确认 GTNH 退出的最长秒数；不会强杀进程。
STOP_TIMEOUT=180

# 启动 GTNH 后等待 RCON 重新可用的最长秒数；大型整合包可适当增大。
STARTUP_TIMEOUT=900

# 单个备份允许的最大解压后总大小（字节），默认 100 GiB；不是压缩包大小。
MAX_ARCHIVE_BYTES=107374182400

# 单个归档允许的最大文件和目录条目数；不是最多保留多少份备份。
MAX_ARCHIVE_MEMBERS=1000000

# 满足暂存空间后，磁盘还必须保留的可用字节数，默认 1 GiB。
FREE_SPACE_RESERVE=1073741824
